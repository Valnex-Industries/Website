# Copy to .env and fill in. Never commit the filled file.

# Site
NEXT_PUBLIC_SITE_URL=https://www.valnexindustries.com

# Supabase
# One project, shared with the Analytics Portal (../Analytics-Portal).
# The anon key reads published products and news; row-level security means it
# cannot see a draft. The service role key writes visitor data — analytics
# events, WhatsApp clicks, newsletter signups — which is why those tables have
# no anonymous insert policy and everything goes through this app's own routes.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Gmail SMTP)
# Requires an App Password, NOT the account password. Turn on 2-Step
# Verification, then myaccount.google.com -> Security -> App passwords.
# INQUIRY_FROM_EMAIL must EQUAL SMTP_USER: Gmail silently rewrites the From
# header to the authenticated account otherwise.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
INQUIRY_FROM_EMAIL=
INQUIRY_TO_EMAIL=

# Analytics
# Salt for the visitor hash. The hash also contains the date, so a visitor id
# changes at midnight and cannot link one day to the next; this salt stops the
# hash being reversible to an IP. Any long random string. Changing it resets
# visitor counting from that moment, so set it once and leave it.
#   openssl rand -hex 32
ANALYTICS_SALT=

# Cache purge
# Shared with the portal's SITE_REVALIDATE_SECRET. Lets the portal drop this
# site's cache the moment an edit is saved, instead of waiting for it to expire.
# Must be the SAME value in both apps.
#   openssl rand -hex 32
SITE_REVALIDATE_SECRET=

# ImageKit (read-only)
# The website never uploads or deletes — it only builds delivery URLs, so it
# needs the endpoint and nothing else. No public or private key here.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
